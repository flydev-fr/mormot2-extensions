<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OTP Demo - {{main.pageName}}</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <link href=".static/otp.css" rel="stylesheet">
</head>
<body class="min-h-full bg-zinc-950 text-zinc-100 antialiased">
<div class="flex min-h-screen flex-col">
  <nav class="border-b border-zinc-800 bg-zinc-900/95 backdrop-blur">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <a class="text-lg font-semibold tracking-tight text-zinc-100 transition hover:text-zinc-300" href="default">🔐 OTP Demo</a>
      <div class="flex items-center gap-2 text-sm">
        {{#main.session}}
        <span class="hidden text-zinc-400 sm:inline">Logged in as <strong class="font-semibold text-zinc-100">{{Username}}</strong></span>
        <a class="border border-zinc-600 px-3 py-1.5 font-medium text-zinc-200 transition hover:border-zinc-500 hover:bg-zinc-800" href="logout">Logout</a>
        {{/main.session}}
        {{^main.session}}
        <a class="px-3 py-1.5 font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100" href="login">Login</a>
        <a class="border border-zinc-600 px-3 py-1.5 font-medium text-zinc-200 transition hover:border-zinc-500 hover:bg-zinc-800" href="register">Register</a>
        {{/main.session}}
      </div>
    </div>
  </nav>
  <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
